# Movera environment variables
# This app uses Supabase exclusively (not Prisma).
# Configure Supabase + TMDB in .env.local (not committed):
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=
#   TMDB_API_KEY=
#   SUBDL_API_KEY=          (optional, for external subtitles)
#   OPENSUBTITLES_API_KEY=  (optional, for external subtitles)
#   OPEN_RELAY_API_KEY=     (optional, for TURN relay)
